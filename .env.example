# Copier en `.env.local` (ignoré par git) pour l'adapter à votre poste.

# Développement : adresse de l'API Marinade vers laquelle `yarn dev` relaie `/api`.
MARINADE_API_URL=http://127.0.0.1:8000

# Racine de l'API vue par le navigateur. Par défaut `/api` (même origine, relayée par
# Vite en développement et par le reverse proxy en production).
# VITE_API_BASE_URL=/api

# Intervalle d'actualisation des écrans « en direct », en millisecondes.
# VITE_LIVE_POLL_INTERVAL_MS=10000

# Pages légales (/privacy et /terms). Facultatif : sans valeur, les pages renvoient vers l'espace Marinade.
# VITE_LEGAL_ENTITY_NAME=Nom de la société éditrice
# VITE_LEGAL_CONTACT_EMAIL=contact@exemple.com
